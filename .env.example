# OpenAI 兼容 API 配置（默认指向 OpenAI）
OPENCLAW_API_BASE=https://api.openai.com/v1
OPENCLAW_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENCLAW_MODEL=gpt-4o-mini

# 可选：自定义参数
# OPENCLAW_MAX_ITERATIONS=10
# OPENCLAW_TEMPERATURE=0.7

# 本地 Ollama 示例（需先启动 ollama serve）：
# OPENCLAW_API_BASE=http://localhost:11434/v1
# OPENCLAW_API_KEY=ollama
# OPENCLAW_MODEL=qwen2.5:7b
